{
  "openapi": "3.0.0",
  "info": {
    "title": "Revocation API",
    "version": "0.1.0",
    "contact": {}
  },
  "paths": {
    "/token_status_list/get": {
      "get": {
        "summary": "Retrieve Token Status",
        "operationId": "getTokenStatusList",
        "description": "Retrieves the status of a token from the revocation list. WARNING: This endpoint is for debug and testing purposes only. Give 'idx', 'id' or both, with the status list or the identifier list URI (the URI only selects the list); both must name the same token (else 400). An unknown 'id' is 404 'Unknown identifier'. Not authenticated.",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": "Identifier list id of the token (the 'id' /take returned): an opaque string of at most 64 characters, not the index. Tokens issued before the ids were random have the index as id."
          },
          {
            "in": "query",
            "name": "idx",
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Index of the token in the status list (the 'idx' /take returned). A non-negative decimal number without sign, spaces or leading zeros."
          },
          {
            "in": "query",
            "name": "uri",
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "Status list or identifier list URI, exactly as /take returned it.",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "'0' (valid) or '1' (revoked).",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "0",
                    "1"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/token_status_list/set": {
      "post": {
        "summary": "Set Token Status",
        "operationId": "setTokenStatus",
        "description": "Revokes a token (status 1): sets its bit in the status list and adds its id to the identifier list. Give 'idx', 'id' or both, with the status list or the identifier list URI (the URI only selects the list); both must name the same token (else 400). An unknown 'id' is 404 'Unknown identifier'. A token never handed out by /take is 404 'Unknown entry'.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "anyOf": [
                  {
                    "required": [
                      "id"
                    ]
                  },
                  {
                    "required": [
                      "idx"
                    ]
                  }
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Identifier list id of the token (the 'id' /take returned): an opaque string of at most 64 characters, not the index. Tokens issued before the ids were random have the index as id.",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "idx": {
                    "type": "integer",
                    "description": "Index of the token in the status list (the 'idx' /take returned). A non-negative decimal number without sign, spaces or leading zeros.",
                    "minimum": 0
                  },
                  "status": {
                    "type": "integer",
                    "enum": [
                      1
                    ],
                    "description": "The new status: only 1 (revoked), written exactly as '1'."
                  },
                  "uri": {
                    "type": "string",
                    "description": "Status list or identifier list URI, exactly as /take returned it."
                  }
                },
                "required": [
                  "status",
                  "uri"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The token is revoked.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "Status Changed\n"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/token_status_list/take": {
      "post": {
        "summary": "Generate status structure",
        "operationId": "takeTokenStatus",
        "description": "Generates a new status structure to be included in a credential as well as a new entry in the attestation status list.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string",
                    "description": "Country code associated with the document."
                  },
                  "doctype": {
                    "type": "string",
                    "description": "Document type (e.g., eu.europa.ec.eudi.pid.1, org.iso.18013.5.1.mDL)."
                  },
                  "expiry_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Expiration date of the document (YYYY-MM-DD, UTC): from today to max_expiry_days (default 3650) ahead."
                  }
                },
                "required": [
                  "country",
                  "doctype",
                  "expiry_date"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful response containing revocation status information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusStructure"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/token_status_list/take/batch": {
      "post": {
        "summary": "Generate several status structures",
        "operationId": "takeTokenStatusBatch",
        "description": "As /token_status_list/take, for 'count' credentials of one country, doctype and expiry date. Full lists are followed by new ones, so the items may point to several lists. All indices are taken or none.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "country": {
                    "type": "string",
                    "description": "Country code associated with the documents."
                  },
                  "doctype": {
                    "type": "string",
                    "description": "Document type (e.g., eu.europa.ec.eudi.pid.1, org.iso.18013.5.1.mDL)."
                  },
                  "expiry_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Latest expiration date of the documents (YYYY-MM-DD, UTC): from today to max_expiry_days (default 3650) ahead."
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Number of indices to take, at most batch_max_size (default 1000)."
                  }
                },
                "required": [
                  "country",
                  "doctype",
                  "expiry_date",
                  "count"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One status structure per index, in the order they were taken; each is what /token_status_list/take returns.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/StatusStructure"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/token_status_list/set/batch": {
      "post": {
        "summary": "Revoke several tokens",
        "operationId": "setTokenStatusBatch",
        "description": "Revokes (status 1) every entry of 'refs', which may belong to several lists, countries and doctypes. All entries are revoked or none: the error names the first ref that failed (e.g. 'refs[3]: Unknown list'). An entry named twice, through either URI, is revoked once; revoked entries stay revoked.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ApiKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "refs": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Entries to revoke, at most batch_max_size (default 1000).",
                    "items": {
                      "type": "object",
                      "properties": {
                        "uri": {
                          "type": "string",
                          "description": "Status list or identifier list URI returned by /take."
                        },
                        "idx": {
                          "type": "integer",
                          "description": "Index of the entry in the status list.",
                          "minimum": 0
                        },
                        "id": {
                          "type": "string",
                          "description": "Identifier list id of the entry, as /take returned it. With 'idx' too, both must name the same entry.",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "required": [
                        "uri"
                      ],
                      "anyOf": [
                        {
                          "required": [
                            "id"
                          ]
                        },
                        {
                          "required": [
                            "idx"
                          ]
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "refs"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every entry is revoked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revoked": {
                      "type": "integer",
                      "description": "Number of distinct entries."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/token_status_list/{country}/{doctype}/{list_id}": {
      "get": {
        "summary": "Get Status List",
        "operationId": "getStatusListToken",
        "description": "The signed status list at the 'status_list.uri' /take returned (draft-ietf-oauth-status-list-12 section 8): a JWT, or a CWT when 'Accept' contains 'application/statuslist+cwt'. Answers carry 'Vary: Accept', 'ETag', 'Last-Modified', 'Cache-Control: no-cache' and 'Access-Control-Allow-Origin: *'. Not authenticated.",
        "parameters": [
          {
            "in": "path",
            "name": "country",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Country code of the list, as in the URI /take returned."
          },
          {
            "in": "path",
            "name": "doctype",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Document type of the list, as in the URI /take returned."
          },
          {
            "in": "path",
            "name": "list_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List id, as in the URI /take returned."
          },
          {
            "in": "header",
            "name": "Accept",
            "schema": {
              "type": "string"
            },
            "description": "'application/statuslist+cwt' for the CWT; anything else gets the JWT."
          }
        ],
        "responses": {
          "200": {
            "description": "The signed status list.",
            "content": {
              "application/statuslist+jwt": {
                "schema": {
                  "type": "string"
                }
              },
              "application/statuslist+cwt": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "The list has not changed since the 'If-None-Match' / 'If-Modified-Since' of the request."
          },
          "404": {
            "description": "Unknown country, doctype or list, or a list that is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/identifier_list/{country}/{doctype}/{list_id}": {
      "get": {
        "summary": "Get Identifier List",
        "operationId": "getIdentifierList",
        "description": "The signed identifier list (a CWT) at the 'identifier_list.uri' /take returned. Answers carry 'ETag', 'Last-Modified', 'Cache-Control: no-cache' and 'Access-Control-Allow-Origin: *'. Not authenticated.",
        "parameters": [
          {
            "in": "path",
            "name": "country",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Country code of the list, as in the URI /take returned."
          },
          {
            "in": "path",
            "name": "doctype",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Document type of the list, as in the URI /take returned."
          },
          {
            "in": "path",
            "name": "list_id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List id, as in the URI /take returned."
          }
        ],
        "responses": {
          "200": {
            "description": "The signed identifier list.",
            "content": {
              "application/identifierlist+cwt": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "304": {
            "description": "The list has not changed since the 'If-None-Match' / 'If-Modified-Since' of the request."
          },
          "404": {
            "description": "Unknown country, doctype or list, or a list that is not published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ApiKey": {
        "in": "header",
        "name": "X-Api-Key",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "API key for authentication."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Missing or invalid field, or a body that is not a JSON object (batches).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Wrong or missing API key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Unauthorized"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown list, unknown 'id', or an index never handed out by /take.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooLarge": {
        "description": "A body over 1 MiB, or a batch over batch_max_size (default 1000).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ServerError": {
        "description": "A list cannot be read or signed.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Unauthorized": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": [
              "Unauthorized access"
            ]
          }
        },
        "required": [
          "message"
        ]
      },
      "StatusStructure": {
        "type": "object",
        "properties": {
          "status_list": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "idx": {
                "type": "integer"
              }
            }
          },
          "identifier_list": {
            "type": "object",
            "properties": {
              "uri": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "description": "Random identifier list id (32 hex characters), unrelated to 'idx'."
              }
            }
          }
        }
      }
    }
  }
}
