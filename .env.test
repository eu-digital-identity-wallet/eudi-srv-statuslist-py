# Environment of the test runs (pytest, CI). Comment lines must start with "#":
# the test command loads this file with grep -v '^#' | xargs.
#
# Use the minimal in-memory configuration (app/config.py mock_config)
# instead of reading the YAML file at STATUS_LIST_CONFIG_PATH. Any non-empty
# value enables it; never set it in production.
MOCK_CONFIGURATION=true
# Test-environment defaults (weak API key accepted, no renewal thread). Only
# this explicit variable, with the exact value "true", enables them, never CI.
EUDIW_TEST_ENV=true
